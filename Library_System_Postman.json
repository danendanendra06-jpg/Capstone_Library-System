  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Sign Up (Register)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"member\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Sign In (Login)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
